{
  "system": "rally",
  "components": [
    {
      "name": "rally-player-east",
      "domains": [
        "rally.east"
      ],
      "commands": [
        "rally.east.ObserveBall"
      ],
      "views": [
        "rally.east.PlayerState"
      ]
    },
    {
      "name": "rally-player-west",
      "domains": [
        "rally.west"
      ],
      "commands": [
        "rally.west.ObserveBall"
      ],
      "views": [
        "rally.west.PlayerState"
      ]
    },
    {
      "name": "rally-table",
      "domains": [
        "rally.table"
      ],
      "commands": [
        "rally.table.MovePaddle",
        "rally.table.OpenMatch",
        "rally.table.Tick"
      ],
      "views": [
        "rally.table.MatchState"
      ]
    }
  ],
  "bindings": [
    {
      "name": "east-moves",
      "kind": "event",
      "from": "rally-player-east",
      "to": "rally-table",
      "event": "rally.east.PaddleMoveRequested",
      "command": "rally.table.MovePaddle",
      "delivery": {
        "guarantee": "at_most_once",
        "attempts": 1
      }
    },
    {
      "name": "east-watches",
      "kind": "event",
      "from": "rally-table",
      "to": "rally-player-east",
      "event": "rally.table.BallMoved",
      "command": "rally.east.ObserveBall",
      "delivery": {
        "guarantee": "at_most_once",
        "attempts": 1
      }
    },
    {
      "name": "tick",
      "kind": "periodic",
      "to": "rally-table",
      "command": "rally.table.Tick",
      "every": "PT1S",
      "anchor": "host_activation",
      "first": "after_period",
      "cadence": "fixed_rate",
      "overlap": "serial_per_instance",
      "missed": "one_pending_drop_excess",
      "lifetime": "host_instance"
    },
    {
      "name": "west-moves",
      "kind": "event",
      "from": "rally-player-west",
      "to": "rally-table",
      "event": "rally.west.PaddleMoveRequested",
      "command": "rally.table.MovePaddle",
      "delivery": {
        "guarantee": "at_most_once",
        "attempts": 1
      }
    },
    {
      "name": "west-watches",
      "kind": "event",
      "from": "rally-table",
      "to": "rally-player-west",
      "event": "rally.table.BallMoved",
      "command": "rally.west.ObserveBall",
      "delivery": {
        "guarantee": "at_most_once",
        "attempts": 1
      }
    }
  ],
  "instances": [
    {
      "instance_id": "rally-table-0",
      "component": "rally-table",
      "target_kind": "QemuMicrovm",
      "target": "microvm-a",
      "state": "Running",
