{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beyond10x.github.io/spindle/schema/commands/spindle.placement.PlanInstance.schema.json",
  "title": "Plan instance input",
  "x-ess-name": "spindle.placement.PlanInstance",
  "x-ess-kind": "command-input",
  "type": "object",
  "properties": {
    "instance_id": {
      "$ref": "#/$defs/spindle.placement.InstanceId"
    },
    "deployment_id": {
      "$ref": "#/$defs/spindle.deployment.DeploymentId"
    },
    "component": {
      "type": "string"
    },
    "settings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/spindle.placement.Setting"
      }
    },
    "target_id": {
      "$ref": "#/$defs/spindle.placement.TargetId"
    },
    "request": {
      "$ref": "#/$defs/spindle.placement.Resources"
    }
  },
  "required": [
    "instance_id",
    "deployment_id",
    "component",
    "settings",
    "target_id",
    "request"
  ],
  "additionalProperties": false,
  "x-ess-provenance": {
    "system": "spindle",
    "specification_version": "v1",
    "contract_digest": "slice-sha256/2:d45f3871fd1675ecbab7c68cd315f1bd3402f8678dd400c8137737f6be62d526",
    "regenerate": "ess generate"
  },
  "$defs": {
    "spindle.deployment.DeploymentId": {
      "title": "DeploymentId",
      "x-ess-name": "spindle.deployment.DeploymentId",
      "x-ess-kind": "newtype",
      "type": "string"
    },
    "spindle.placement.InstanceId": {
      "title": "InstanceId",
      "x-ess-name": "spindle.placement.InstanceId",
      "x-ess-kind": "newtype",
      "type": "string"
    },
    "spindle.placement.Resources": {
      "title": "Resources",
      "description": "How much of each resource one instance may take or asks for: virtual CPUs, memory and disk in MiB. None is below zero, and the vCPUs fit 32 bits, as `spindle_target::Resources` holds them (`u32`, `u64`, `u64`).",
      "x-ess-name": "spindle.placement.Resources",
      "x-ess-kind": "struct",
      "type": "object",
      "properties": {
        "vcpus": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "memory_mib": {
          "type": "integer",
          "minimum": 0
        },
        "disk_mib": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "vcpus",
        "memory_mib",
        "disk_mib"
      ],
      "additionalProperties": false,
      "x-ess-invariants": [
        "vcpus >= 0",
        "vcpus <= 4294967295",
        "memory_mib >= 0",
        "disk_mib >= 0"
      ]
    },
    "spindle.placement.Setting": {
      "title": "Setting",
      "x-ess-name": "spindle.placement.Setting",
      "x-ess-kind": "struct",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "additionalProperties": false
    },
    "spindle.placement.TargetId": {
      "title": "TargetId",
      "x-ess-name": "spindle.placement.TargetId",
      "x-ess-kind": "newtype",
      "type": "string"
    }
  }
