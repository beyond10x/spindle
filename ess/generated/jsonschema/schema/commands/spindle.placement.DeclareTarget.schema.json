{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beyond10x.github.io/spindle/schema/commands/spindle.placement.DeclareTarget.schema.json",
  "title": "Declare target input",
  "x-ess-name": "spindle.placement.DeclareTarget",
  "x-ess-kind": "command-input",
  "type": "object",
  "properties": {
    "target_id": {
      "$ref": "#/$defs/spindle.placement.TargetId"
    },
    "kind": {
      "$ref": "#/$defs/spindle.placement.TargetKind"
    },
    "environment_id": {
      "$ref": "#/$defs/spindle.deployment.EnvironmentId"
    },
    "ceiling": {
      "$ref": "#/$defs/spindle.placement.Resources"
    }
  },
  "required": [
    "target_id",
    "kind",
    "environment_id",
    "ceiling"
  ],
  "additionalProperties": false,
  "x-ess-provenance": {
    "system": "spindle",
    "specification_version": "v1",
    "contract_digest": "slice-sha256/2:8797c1d7242e007b326d5c642e936f8c700593a7c9e7af41f2192a275c17d24d",
    "regenerate": "ess generate"
  },
  "$defs": {
    "spindle.deployment.EnvironmentId": {
      "title": "EnvironmentId",
      "x-ess-name": "spindle.deployment.EnvironmentId",
      "x-ess-kind": "newtype",
      "type": "string"
    },
    "spindle.placement.Resources": {
      "title": "Resources",
      "description": "How much of each resource one instance may take or asks for: virtual CPUs, memory and disk in MiB. None is below zero, and the vCPUs fit 32 bits, as `spindle_target::Resources` holds them (`u32`, `u64`, `u64`).",
      "x-ess-name": "spindle.placement.Resources",
      "x-ess-kind": "struct",
      "type": "object",
      "properties": {
        "vcpus": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "memory_mib": {
          "type": "integer",
          "minimum": 0
        },
        "disk_mib": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "vcpus",
        "memory_mib",
        "disk_mib"
      ],
      "additionalProperties": false,
      "x-ess-invariants": [
        "vcpus >= 0",
        "vcpus <= 4294967295",
        "memory_mib >= 0",
        "disk_mib >= 0"
      ]
    },
    "spindle.placement.TargetId": {
      "title": "TargetId",
      "x-ess-name": "spindle.placement.TargetId",
      "x-ess-kind": "newtype",
      "type": "string"
    },
    "spindle.placement.TargetKind": {
      "title": "TargetKind",
      "x-ess-name": "spindle.placement.TargetKind",
      "x-ess-kind": "enum",
      "type": "string",
      "enum": [
        "Process",
        "QemuMicrovm",
        "Firecracker",
        "Docker",
        "Compose",
        "Kubernetes",
        "Browser"
      ]
    }
  }
