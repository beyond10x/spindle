{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beyond10x.github.io/spindle/schema/entities/spindle.placement.Instance.schema.json",
  "title": "Instance",
  "x-ess-name": "spindle.placement.Instance",
  "x-ess-kind": "entity",
  "type": "object",
  "properties": {
    "instance_id": {
      "$ref": "#/$defs/spindle.placement.InstanceId"
    },
    "deployment_id": {
      "$ref": "#/$defs/spindle.deployment.DeploymentId",
      "x-ess-relation": {
        "name": "deployment",
        "kind": "references",
        "source": "spindle.placement.Instance",
        "target": "spindle.deployment.Deployment",
        "cardinality": "one",
        "via": "deployment_id"
      }
    },
    "component": {
      "type": "string"
    },
    "settings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/spindle.placement.Setting"
      }
    },
    "target_id": {
      "$ref": "#/$defs/spindle.placement.TargetId",
      "x-ess-relation": {
        "name": "target",
        "kind": "references",
        "source": "spindle.placement.Instance",
        "target": "spindle.placement.Target",
        "cardinality": "one",
        "via": "target_id"
      }
    },
    "request": {
      "$ref": "#/$defs/spindle.placement.Resources"
    },
    "refusal": {
      "$ref": "#/$defs/spindle.placement.RefusalCause"
    },
    "state": {
      "$ref": "#/$defs/spindle.placement.Instance.State"
    }
  },
  "required": [
    "instance_id",
    "deployment_id",
    "component",
    "settings",
    "target_id",
    "request",
    "state"
  ],
  "additionalProperties": false,
  "x-ess-provenance": {
    "system": "spindle",
    "specification_version": "v1",
    "contract_digest": "slice-sha256/2:5ed11890d35ffe7476bf795195e258e3d07b70f0026c27703c3b98c152e23844",
    "regenerate": "ess generate"
  },
  "$defs": {
    "spindle.deployment.DeploymentId": {
      "title": "DeploymentId",
      "x-ess-name": "spindle.deployment.DeploymentId",
      "x-ess-kind": "newtype",
      "type": "string"
    },
    "spindle.placement.Instance.State": {
      "title": "State",
      "x-ess-name": "spindle.placement.Instance.State",
      "x-ess-kind": "enum",
      "type": "string",
      "enum": [
        "Exited",
        "Placed",
        "Planned",
        "Refused",
        "Running"
      ]
    },
    "spindle.placement.InstanceId": {
      "title": "InstanceId",
      "x-ess-name": "spindle.placement.InstanceId",
      "x-ess-kind": "newtype",
      "type": "string"
    },
    "spindle.placement.RefusalCause": {
      "title": "RefusalCause",
      "description": "Why an instance was refused. An instance refused for several reasons at once records one: the first of these in the order they are declared, which is the order `PlaceInstance` decides them in.",
      "x-ess-name": "spindle.placement.RefusalCause",
      "x-ess-kind": "enum",
      "type": "string",
      "enum": [
        "TargetRetired",
        "EnvironmentMismatch",
        "NotAdmitted",
        "AboveCeiling"
      ]
    },
    "spindle.placement.Resources": {
      "title": "Resources",
      "description": "How much of each resource one instance may take or asks for: virtual CPUs, memory and disk in MiB. None is below zero, and the vCPUs fit 32 bits, as `spindle_target::Resources` holds them (`u32`, `u64`, `u64`).",
      "x-ess-name": "spindle.placement.Resources",
      "x-ess-kind": "struct",
      "type": "object",
      "properties": {
        "vcpus": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "memory_mib": {
          "type": "integer",
          "minimum": 0
        },
        "disk_mib": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "vcpus",
        "memory_mib",
        "disk_mib"
      ],
      "additionalProperties": false,
      "x-ess-invariants": [
        "vcpus >= 0",
        "vcpus <= 4294967295",
        "memory_mib >= 0",
        "disk_mib >= 0"
      ]
    },
    "spindle.placement.Setting": {
      "title": "Setting",
      "x-ess-name": "spindle.placement.Setting",
      "x-ess-kind": "struct",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "additionalProperties": false
    },
    "spindle.placement.TargetId": {
      "title": "TargetId",
      "x-ess-name": "spindle.placement.TargetId",
      "x-ess-kind": "newtype",
      "type": "string"
    }
  }
}
