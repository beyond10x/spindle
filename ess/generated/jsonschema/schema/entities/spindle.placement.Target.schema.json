        "memory_mib",
        "disk_mib"
      ],
      "additionalProperties": false,
      "x-ess-invariants": [
        "vcpus >= 0",
        "vcpus <= 4294967295",
        "memory_mib >= 0",
        "disk_mib >= 0"
      ]
