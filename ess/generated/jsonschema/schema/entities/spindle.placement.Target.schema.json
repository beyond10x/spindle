      "x-ess-kind": "struct",
      "type": "object",
      "properties": {
        "vcpus": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "memory_mib": {
          "type": "integer",
          "minimum": 0
        },
        "disk_mib": {
          "type": "integer",
          "minimum": 0
