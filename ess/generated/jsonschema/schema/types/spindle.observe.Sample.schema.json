{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beyond10x.github.io/spindle/schema/types/spindle.observe.Sample.schema.json",
  "$ref": "#/$defs/spindle.observe.Sample",
  "x-ess-provenance": {
    "system": "spindle",
    "specification_version": "v1",
    "contract_digest": "slice-sha256/2:3fdae22d79f54dc2c02341df9532a43c1f6447be2a05275527c95f9f5d536b3f",
    "regenerate": "ess generate"
  },
  "$defs": {
    "spindle.observe.CounterValue": {
      "title": "CounterValue",
      "description": "The cumulative value of one counter of the catalogue.",
      "x-ess-name": "spindle.observe.CounterValue",
      "x-ess-kind": "struct",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "name",
        "value"
      ],
      "additionalProperties": false,
      "x-ess-invariants": [
        "value >= 0"
      ]
    },
    "spindle.observe.Histogram": {
      "title": "Histogram",
      "description": "The cumulative buckets of one histogram of the catalogue. `bounds` are the inclusive upper bounds of the buckets in ascending order; `counts` has one entry per bound and one more for the values above the last bound; `sum_us` is the sum of the observed values in microseconds.",
      "x-ess-name": "spindle.observe.Histogram",
      "x-ess-kind": "struct",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "bounds": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "counts": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "sum_us": {
          "type": "integer"
        }
      },
      "required": [
        "name",
        "bounds",
        "counts",
        "sum_us"
      ],
      "additionalProperties": false
    },
    "spindle.observe.Payload": {
      "title": "Payload",
      "description": "An event payload as JSON text, truncated to at most 1 KiB.",
      "x-ess-name": "spindle.observe.Payload",
      "x-ess-kind": "newtype",
      "type": "string",
      "x-ess-invariants": [
        "value.utf8_bytes <= 1024"
      ]
    },
    "spindle.observe.RecentAnswer": {
      "title": "RecentAnswer",
      "description": "One command the instance executed, its outcome and the events it appended.",
      "x-ess-name": "spindle.observe.RecentAnswer",
      "x-ess-kind": "struct",
      "type": "object",
      "properties": {
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "command": {
          "type": "string"
        },
        "outcome": {
          "type": "string"
        },
        "events": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "payload": {
          "$ref": "#/$defs/spindle.observe.Payload",
          "description": "The payload of the first event appended, if any."
        }
      },
      "required": [
        "at",
        "command",
        "outcome",
        "events"
      ],
      "additionalProperties": false
    },
    "spindle.observe.ResourceReading": {
      "title": "ResourceReading",
      "description": "What the instance costs the host. A share is the reading against the instance's request: `cpu_share` is CPU seconds over wall seconds times requested vCPUs, `memory_share` is memory over requested MiB. An instance without a limit has no share.",
      "x-ess-name": "spindle.observe.ResourceReading",
      "x-ess-kind": "struct",
      "type": "object",
      "properties": {
        "cpu_seconds": {
          "type": "number",
          "minimum": 0
        },
        "memory_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "cpu_share": {
          "type": "number"
        },
        "memory_share": {
          "type": "number"
        }
      },
      "required": [
        "cpu_seconds",
        "memory_bytes"
      ],
      "additionalProperties": false,
      "x-ess-invariants": [
        "cpu_seconds >= 0",
        "memory_bytes >= 0"
      ]
    },
    "spindle.observe.Sample": {
      "title": "Sample",
      "description": "One `sample` message of `GET /api/stream`: the cumulative counters of one instance at one instant. A lost sample is harmless, because the next one carries every total again.",
      "x-ess-name": "spindle.observe.Sample",
      "x-ess-kind": "struct",
      "type": "object",
      "properties": {
        "instance_id": {
          "$ref": "#/$defs/spindle.placement.InstanceId"
        },
        "sequence": {
          "description": "Monotonic per instance, starting at 0.",
          "type": "integer",
          "minimum": 0
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "period_ms": {
          "description": "The sampling period the instance runs with, in milliseconds.",
          "type": "integer",
          "minimum": 1
        },
        "counters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/spindle.observe.CounterValue"
          }
        },
        "histograms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/spindle.observe.Histogram"
          }
        },
        "recent": {
          "description": "The last command answers of the instance, newest first.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/spindle.observe.RecentAnswer"
          }
        },
        "resources": {
          "$ref": "#/$defs/spindle.observe.ResourceReading"
        },
        "dropped_frames": {
          "description": "Samples the instance dropped since launch because the control process was slow or gone.",
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "instance_id",
        "sequence",
        "at",
        "period_ms",
        "counters",
        "histograms",
        "recent",
        "resources",
        "dropped_frames"
      ],
      "additionalProperties": false,
      "x-ess-invariants": [
        "sequence >= 0",
        "period_ms > 0",
        "dropped_frames >= 0"
      ]
    },
    "spindle.placement.InstanceId": {
      "title": "InstanceId",
      "x-ess-name": "spindle.placement.InstanceId",
      "x-ess-kind": "newtype",
      "type": "string"
    }
  }
}
