    "spindle.observe.ResourceReading": {
      "title": "ResourceReading",
      "description": "What the instance costs the host. A share is the reading against the instance's request: `cpu_share` is CPU seconds over wall seconds times requested vCPUs, `memory_share` is memory over requested MiB. An instance without a limit has no share.",
      "x-ess-name": "spindle.observe.ResourceReading",
      "x-ess-kind": "struct",
      "type": "object",
      "properties": {
        "cpu_seconds": {
          "type": "number",
          "minimum": 0
        },
        "memory_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "cpu_share": {
          "type": "number"
        },
        "memory_share": {
          "type": "number"
        }
      },
      "required": [
        "cpu_seconds",
        "memory_bytes"
      ],
      "additionalProperties": false,
      "x-ess-invariants": [
        "cpu_seconds >= 0",
        "memory_bytes >= 0"
      ]
    }
  }
