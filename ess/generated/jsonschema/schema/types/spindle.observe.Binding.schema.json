    "regenerate": "ess generate"
  },
  "$defs": {
    "spindle.observe.Binding": {
      "title": "Binding",
      "description": "One binding of the system. A periodic binding fires a command of `to` on a schedule and has no `from` and no `event`; an event binding carries `event` from `from` to a command of `to`.",
      "x-ess-name": "spindle.observe.Binding",
      "x-ess-kind": "struct",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/spindle.observe.BindingKind"
        },
        "from": {
          "description": "The component that publishes the event; absent for a periodic binding.",
          "type": "string"
        },
        "to": {
          "description": "The component that accepts the command.",
          "type": "string"
        },
        "event": {
          "description": "The qualified name of the event carried; absent for a periodic binding.",
          "type": "string"
        },
        "command": {
          "description": "The qualified name of the command the binding issues.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "kind",
        "to",
        "command"
      ],
      "additionalProperties": false
    },
    "spindle.observe.BindingKind": {
      "title": "BindingKind",
      "x-ess-name": "spindle.observe.BindingKind",
      "x-ess-kind": "enum",
      "type": "string",
      "enum": [
        "periodic",
        "event"
      ]
    }
  }
