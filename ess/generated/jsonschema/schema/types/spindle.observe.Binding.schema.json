  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beyond10x.github.io/spindle/schema/types/spindle.observe.Binding.schema.json",
  "$ref": "#/$defs/spindle.observe.Binding",
  "x-ess-provenance": {
    "system": "spindle",
