{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beyond10x.github.io/spindle/schema/types/spindle.observe.DeployedInstance.schema.json",
  "$ref": "#/$defs/spindle.observe.DeployedInstance",
  "x-ess-provenance": {
    "system": "spindle",
    "specification_version": "v1",
    "contract_digest": "slice-sha256/2:d0a2f22aa138b3713de8798cea1b251cfae1e3d76417f899cca328bbd4102dc1",
    "regenerate": "ess generate"
  },
  "$defs": {
    "spindle.observe.DeployedInstance": {
      "title": "DeployedInstance",
      "description": "One instance of a component, where it was placed, what it requested and its state.",
      "x-ess-name": "spindle.observe.DeployedInstance",
      "x-ess-kind": "struct",
      "type": "object",
      "properties": {
        "instance_id": {
          "$ref": "#/$defs/spindle.placement.InstanceId"
        },
        "component": {
          "type": "string"
        },
        "target_kind": {
          "$ref": "#/$defs/spindle.placement.TargetKind"
        },
        "target": {
          "$ref": "#/$defs/spindle.placement.TargetId"
        },
        "state": {
          "$ref": "#/$defs/spindle.placement.Instance.State"
        },
        "requested": {
          "$ref": "#/$defs/spindle.placement.Resources"
        },
        "started_at": {
          "description": "When the instance was launched; absent until it runs.",
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "instance_id",
        "component",
        "target_kind",
        "target",
        "state",
        "requested"
      ],
      "additionalProperties": false
    },
    "spindle.placement.Instance.State": {
      "title": "State",
      "x-ess-name": "spindle.placement.Instance.State",
      "x-ess-kind": "enum",
      "type": "string",
      "enum": [
        "Exited",
        "Placed",
        "Planned",
        "Refused",
        "Running"
      ]
    },
    "spindle.placement.InstanceId": {
      "title": "InstanceId",
      "x-ess-name": "spindle.placement.InstanceId",
      "x-ess-kind": "newtype",
      "type": "string"
    },
    "spindle.placement.Resources": {
      "title": "Resources",
      "description": "How much of each resource one instance may take or asks for: virtual CPUs, memory and disk in MiB. None is below zero, and the vCPUs fit 32 bits, as `spindle_target::Resources` holds them (`u32`, `u64`, `u64`).",
      "x-ess-name": "spindle.placement.Resources",
      "x-ess-kind": "struct",
      "type": "object",
      "properties": {
        "vcpus": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "memory_mib": {
          "type": "integer",
          "minimum": 0
        },
        "disk_mib": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "vcpus",
        "memory_mib",
        "disk_mib"
      ],
      "additionalProperties": false,
      "x-ess-invariants": [
        "vcpus >= 0",
        "vcpus <= 4294967295",
        "memory_mib >= 0",
        "disk_mib >= 0"
      ]
    },
    "spindle.placement.TargetId": {
      "title": "TargetId",
      "x-ess-name": "spindle.placement.TargetId",
      "x-ess-kind": "newtype",
      "type": "string"
    },
    "spindle.placement.TargetKind": {
      "title": "TargetKind",
      "x-ess-name": "spindle.placement.TargetKind",
      "x-ess-kind": "enum",
      "type": "string",
      "enum": [
        "Process",
        "QemuMicrovm",
        "Firecracker",
        "Docker",
        "Compose",
        "Kubernetes",
        "Browser"
      ]
    }
  }
}
