{
  "$defs": {
    "spindle.observe.Binding": {
      "additionalProperties": false,
      "description": "One binding of the system. A periodic binding fires a command of `to` on a schedule and has no `from` and no `event`; an event binding carries `event` from `from` to a command of `to`.",
      "properties": {
        "command": {
          "description": "The qualified name of the command the binding issues.",
          "type": "string"
        },
        "event": {
          "description": "The qualified name of the event carried; absent for a periodic binding.",
          "type": "string"
        },
        "from": {
          "description": "The component that publishes the event; absent for a periodic binding.",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/spindle.observe.BindingKind"
        },
        "name": {
          "type": "string"
        },
        "to": {
          "description": "The component that accepts the command.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "kind",
        "to",
        "command"
      ],
      "title": "Binding",
      "type": "object",
      "x-ess-kind": "struct",
      "x-ess-name": "spindle.observe.Binding"
    },
    "spindle.observe.BindingKind": {
      "enum": [
        "periodic",
        "event"
      ],
      "title": "BindingKind",
      "type": "string",
      "x-ess-kind": "enum",
      "x-ess-name": "spindle.observe.BindingKind"
    },
    "spindle.observe.Catalogue": {
      "additionalProperties": false,
      "description": "The answer of `GET /api/catalogue?component=`, every counter the runtime derives for one component from the compiled specification.",
      "properties": {
        "component": {
          "type": "string"
        },
        "counters": {
          "items": {
            "$ref": "#/$defs/spindle.observe.Counter"
          },
          "type": "array"
        }
      },
      "required": [
        "component",
        "counters"
      ],
      "title": "Catalogue",
      "type": "object",
      "x-ess-kind": "struct",
      "x-ess-name": "spindle.observe.Catalogue"
    },
    "spindle.observe.Component": {
      "additionalProperties": false,
      "description": "One component of the system, with the domains it owns and what it accepts and serves.",
      "properties": {
        "commands": {
          "description": "The qualified names of the commands the component accepts.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "domains": {
          "description": "The qualified names of the domains the component owns.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "name": {
          "type": "string"
        },
        "views": {
          "description": "The qualified names of the views the component serves.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "name",
        "domains",
        "commands",
        "views"
      ],
      "title": "Component",
      "type": "object",
      "x-ess-kind": "struct",
      "x-ess-name": "spindle.observe.Component"
    },
    "spindle.observe.Counter": {
      "additionalProperties": false,
      "description": "One counter of the catalogue, by its dotted name, such as `command.rally.table.Tick.served`.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/spindle.observe.CounterKind"
        },
        "name": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/spindle.observe.CounterSource"
        }
      },
      "required": [
        "name",
        "kind",
        "source"
      ],
      "title": "Counter",
      "type": "object",
      "x-ess-kind": "struct",
      "x-ess-name": "spindle.observe.Counter"
    },
    "spindle.observe.CounterKind": {
      "enum": [
        "counter",
        "histogram"
      ],
      "title": "CounterKind",
      "type": "string",
      "x-ess-kind": "enum",
      "x-ess-name": "spindle.observe.CounterKind"
    },
    "spindle.observe.CounterSource": {
      "enum": [
        "kernel",
        "store",
        "channel",
        "timer",
        "ingress",
        "view",
        "resource"
      ],
      "title": "CounterSource",
      "type": "string",
      "x-ess-kind": "enum",
      "x-ess-name": "spindle.observe.CounterSource"
    },
    "spindle.observe.CounterValue": {
      "additionalProperties": false,
      "description": "The cumulative value of one counter of the catalogue.",
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "title": "CounterValue",
      "type": "object",
      "x-ess-invariants": [
        "value >= 0"
      ],
      "x-ess-kind": "struct",
      "x-ess-name": "spindle.observe.CounterValue"
    },
    "spindle.observe.DeployedInstance": {
      "additionalProperties": false,
      "description": "One instance of a component, where it was placed, what it requested and its state.",
      "properties": {
        "component": {
          "type": "string"
        },
        "instance_id": {
          "$ref": "#/$defs/spindle.placement.InstanceId"
        },
        "requested": {
          "$ref": "#/$defs/spindle.placement.Resources"
        },
        "started_at": {
          "description": "When the instance was launched; absent until it runs.",
          "format": "date-time",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/spindle.placement.Instance.State"
        },
        "target": {
          "$ref": "#/$defs/spindle.placement.TargetId"
        },
        "target_kind": {
          "$ref": "#/$defs/spindle.placement.TargetKind"
        }
      },
      "required": [
        "instance_id",
        "component",
        "target_kind",
        "target",
        "state",
        "requested"
      ],
      "title": "DeployedInstance",
      "type": "object",
      "x-ess-kind": "struct",
      "x-ess-name": "spindle.observe.DeployedInstance"
    },
    "spindle.observe.Deployment": {
      "additionalProperties": false,
      "description": "The answer of `GET /api/deployment`, the system as deployed.",
      "properties": {
        "bindings": {
          "items": {
            "$ref": "#/$defs/spindle.observe.Binding"
          },
          "type": "array"
        },
        "components": {
          "items": {
            "$ref": "#/$defs/spindle.observe.Component"
          },
          "type": "array"
        },
        "instances": {
          "items": {
            "$ref": "#/$defs/spindle.observe.DeployedInstance"
          },
          "type": "array"
        },
        "system": {
          "description": "The system identifier of the deployed specification.",
          "type": "string"
        }
      },
      "required": [
        "system",
        "components",
        "bindings",
        "instances"
      ],
      "title": "Deployment",
      "type": "object",
      "x-ess-kind": "struct",
      "x-ess-name": "spindle.observe.Deployment"
    },
    "spindle.observe.Histogram": {
      "additionalProperties": false,
      "description": "The cumulative buckets of one histogram of the catalogue. `bounds` are the inclusive upper bounds of the buckets in ascending order; `counts` has one entry per bound and one more for the values above the last bound.",
      "properties": {
        "bounds": {
          "items": {
            "type": "integer"
          },
          "type": "array"
        },
        "counts": {
          "items": {
            "type": "integer"
          },
          "type": "array"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "bounds",
        "counts"
      ],
      "title": "Histogram",
      "type": "object",
      "x-ess-kind": "struct",
      "x-ess-name": "spindle.observe.Histogram"
    },
    "spindle.observe.Payload": {
      "description": "An event payload as JSON text, truncated to at most 1 KiB.",
      "title": "Payload",
      "type": "string",
      "x-ess-invariants": [
        "value.utf8_bytes <= 1024"
      ],
      "x-ess-kind": "newtype",
      "x-ess-name": "spindle.observe.Payload"
    },
    "spindle.observe.RecentAnswer": {
      "additionalProperties": false,
      "description": "One command the instance executed, its outcome and the events it appended.",
      "properties": {
        "at": {
          "format": "date-time",
          "type": "string"
        },
        "command": {
          "type": "string"
        },
        "events": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "outcome": {
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/spindle.observe.Payload",
          "description": "The payload of the first event appended, if any."
        }
      },
      "required": [
        "at",
        "command",
        "outcome",
        "events"
      ],
      "title": "RecentAnswer",
      "type": "object",
      "x-ess-kind": "struct",
      "x-ess-name": "spindle.observe.RecentAnswer"
    },
    "spindle.observe.ResourceReading": {
      "additionalProperties": false,
      "description": "What the instance costs the host. A share is the reading against the instance's request: `cpu_share` is CPU seconds over wall seconds times requested vCPUs, `memory_share` is memory over requested MiB. An instance without a limit has no share.",
      "properties": {
        "cpu_seconds": {
          "minimum": 0,
          "type": "number"
        },
        "cpu_share": {
          "type": "number"
        },
        "memory_bytes": {
          "minimum": 0,
          "type": "integer"
        },
        "memory_share": {
          "type": "number"
        }
      },
      "required": [
        "cpu_seconds",
        "memory_bytes"
      ],
      "title": "ResourceReading",
      "type": "object",
      "x-ess-invariants": [
        "cpu_seconds >= 0",
        "memory_bytes >= 0"
      ],
      "x-ess-kind": "struct",
      "x-ess-name": "spindle.observe.ResourceReading"
    },
    "spindle.observe.Sample": {
      "additionalProperties": false,
      "description": "One `sample` message of `GET /api/stream`: the cumulative counters of one instance at one instant. A lost sample is harmless, because the next one carries every total again.",
      "properties": {
        "at": {
          "format": "date-time",
          "type": "string"
        },
        "counters": {
          "items": {
            "$ref": "#/$defs/spindle.observe.CounterValue"
          },
          "type": "array"
        },
        "dropped_frames": {
          "description": "Samples the instance dropped since launch because the control process was slow or gone.",
          "minimum": 0,
          "type": "integer"
        },
        "histograms": {
          "items": {
            "$ref": "#/$defs/spindle.observe.Histogram"
          },
          "type": "array"
        },
        "instance_id": {
          "$ref": "#/$defs/spindle.placement.InstanceId"
        },
        "period_ms": {
          "description": "The sampling period the instance runs with, in milliseconds.",
          "minimum": 1,
          "type": "integer"
        },
        "recent": {
          "description": "The last command answers of the instance, newest first.",
          "items": {
            "$ref": "#/$defs/spindle.observe.RecentAnswer"
          },
          "type": "array"
        },
        "resources": {
          "$ref": "#/$defs/spindle.observe.ResourceReading"
        },
        "sequence": {
          "description": "Monotonic per instance, starting at 0.",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "instance_id",
        "sequence",
        "at",
        "period_ms",
        "counters",
        "histograms",
        "recent",
        "resources",
        "dropped_frames"
      ],
      "title": "Sample",
      "type": "object",
      "x-ess-invariants": [
        "sequence >= 0",
        "period_ms > 0",
        "dropped_frames >= 0"
      ],
      "x-ess-kind": "struct",
      "x-ess-name": "spindle.observe.Sample"
    },
    "spindle.observe.StateChange": {
      "additionalProperties": false,
      "description": "One `state` message of `GET /api/stream`, an instance moving from one state to another.",
      "properties": {
        "at": {
          "format": "date-time",
          "type": "string"
        },
        "from": {
          "$ref": "#/$defs/spindle.placement.Instance.State"
        },
        "instance_id": {
          "$ref": "#/$defs/spindle.placement.InstanceId"
        },
        "to": {
          "$ref": "#/$defs/spindle.placement.Instance.State"
        }
      },
      "required": [
        "instance_id",
        "from",
        "to",
        "at"
      ],
      "title": "StateChange",
      "type": "object",
      "x-ess-kind": "struct",
      "x-ess-name": "spindle.observe.StateChange"
    },
    "spindle.placement.Instance.State": {
      "enum": [
        "Exited",
        "Placed",
        "Planned",
        "Refused",
        "Running"
      ],
      "title": "State",
      "type": "string",
      "x-ess-kind": "enum",
      "x-ess-name": "spindle.placement.Instance.State"
    },
    "spindle.placement.InstanceId": {
      "title": "InstanceId",
      "type": "string",
      "x-ess-kind": "newtype",
      "x-ess-name": "spindle.placement.InstanceId"
    },
    "spindle.placement.Resources": {
      "additionalProperties": false,
      "properties": {
        "disk_mib": {
          "type": "integer"
        },
        "memory_mib": {
          "type": "integer"
        },
        "vcpus": {
          "type": "integer"
        }
      },
      "required": [
        "vcpus",
        "memory_mib",
        "disk_mib"
      ],
      "title": "Resources",
      "type": "object",
      "x-ess-kind": "struct",
      "x-ess-name": "spindle.placement.Resources"
    },
    "spindle.placement.TargetId": {
      "title": "TargetId",
      "type": "string",
      "x-ess-kind": "newtype",
      "x-ess-name": "spindle.placement.TargetId"
    },
    "spindle.placement.TargetKind": {
      "enum": [
        "Process",
        "QemuMicrovm",
        "Firecracker",
        "Docker",
        "Compose",
        "Kubernetes",
        "Browser"
      ],
      "title": "TargetKind",
      "type": "string",
      "x-ess-kind": "enum",
      "x-ess-name": "spindle.placement.TargetKind"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-ess-provenance": {
    "contract_digest": "slice-sha256/2:382566bbefad45f2e426ebbd36cecab4bca84822d89e11d34598401d20af38fd",
    "source_digest": "b0323bd1b17b440667a0e30d35c641bb4c677631463b1780fc33bb351942384a",
    "specification_version": "v1",
    "system": "spindle"
  }
}
